# Informatyk Kórnik — konfiguracja Nginx (przykład)
#
# Umieść pliki strony w katalogu root (np. /var/www/informatykkornik).
# Dostosuj server_name i ścieżki SSL.

server {
    listen 80;
    listen [::]:80;
    server_name informatykkornik.pl www.informatykkornik.pl;
    return 301 https://informatykkornik.pl$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.informatykkornik.pl;
    return 301 https://informatykkornik.pl$request_uri;

    # ssl_certificate     /etc/letsencrypt/live/informatykkornik.pl/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/informatykkornik.pl/privkey.pem;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name informatykkornik.pl;

    root /var/www/informatykkornik;
    index index.html;

    # ssl_certificate     /etc/letsencrypt/live/informatykkornik.pl/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/informatykkornik.pl/privkey.pem;

    # Bezpieczeństwo
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Kompresja
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # Cache statycznych zasobów
    location ~* \.(woff2|webp|jpg|png|svg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location ~* \.(css|js)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    location = /robots.txt { access_log off; }
    location = /favicon.svg { access_log off; log_not_found off; }

    location / {
        try_files $uri $uri/ =404;
    }

    # Opcjonalnie: Brotli (jeśli moduł dostępny)
    # brotli on;
    # brotli_types text/plain text/css application/javascript image/svg+xml;
}
